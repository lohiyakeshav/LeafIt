# Backend settings. Local dev: copy to backend/.env (git-ignored) and fill in; app/config.py loads it at startup.
# Exported variables (Cloud Run env, your shell) take precedence. Real values must never be committed.

# Earth Engine: a service-account key (local dev) or leave unset on Cloud Run to use the runtime service account.
# The account needs roles/earthengine.viewer (or writer) AND roles/serviceusage.serviceUsageConsumer on the project,
# and the project must be registered for Earth Engine.
GOOGLE_APPLICATION_CREDENTIALS=../EarthCredentials.json
EE_PROJECT=

# Server-side key for Places (landmarks) and Air Quality. Optional: without it landmarks are empty and AQI uses a default.
GOOGLE_MAPS_SERVER_KEY=

# Gemini (planner agent, photo audit, proposals)
GEMINI_API_KEY=


# Models: LEAFIT_GEMINI_MODEL for the cheap writers, LEAFIT_PLANNER_MODEL for the planner agent (defaults to the first)
LEAFIT_GEMINI_MODEL=gemini-2.5-flash
# LEAFIT_PLANNER_MODEL=gemini-2.5-pro
# LEAFIT_PLANNER_THINKING=1024

# Vertex AI instead of an API key: path (relative to backend/) of a service-account key, or just set GOOGLE_CLOUD_PROJECT and use ADC.
# LEAFIT_VERTEX_CREDENTIALS=vertexAI.json
# LEAFIT_GEMINI_BACKEND=vertex   # studio|vertex when both are configured (default: prefer GEMINI_API_KEY)
# GOOGLE_CLOUD_LOCATION=global
