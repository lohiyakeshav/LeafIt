# Only what is needed to build, run and test LeafIt is committed. Everything below stays on disk, untracked.

# Working docs and internal notes (PRD, plan, decisions, architecture notes, per-package guides)
docs/
ARCHITECTURE.md
backend/README.md
frontend/README.md

# Flutter app build output (its own flutter_app/.gitignore covers the rest)
flutter_app/build/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Runtime data written by the app (expiring caches and daily rate records)
backend/data/plans/
backend/data/areas/
backend/data/fx/

# Secrets: keys and service accounts never go in git
.env
.env.*
!.env.example
*.pem
*service-account*.json
*credentials*.json
*[Cc]redentials*.json
EarthCredentials.json

# Build outputs (rebuilt from source)
*.apk
*.aab

# Editor and OS clutter
.DS_Store
.vscode/
.idea/
*.iml
